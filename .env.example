# Copy to .env (gitignored) and fill in.

# store   = every trial file in data/store/trials/ (default). No key needed.
# fixture = the 7 hand-written demo trials.
DATA_SOURCE=store

# Needed only for the optional `npm run compile:store`. Set ONE. DeepSeek wins if both.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# Optional overrides.
COMPILE_MODEL=claude-haiku-5-5
EVAL_MODEL=claude-sonnet-5-5
COMPILE_CONCURRENCY=16
# all = every trial; demo = only the 10 demo conditions (cheaper first pass).
COMPILE_SCOPE=all
